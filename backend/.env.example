# PostgreSQL (локально: 127.0.0.1; в Docker задаётся в docker-compose)
DATABASE_URL=postgresql://solar:solar@127.0.0.1:5432/solar

# Пароль БД (в docker-compose подставляется в DATABASE_URL)
POSTGRES_PASSWORD=solar

# Порт API (опционально)
PORT=4000

# Разрешённые origins для CORS (через запятую)
CORS_ORIGINS=https://test.ru,http://127.0.0.1:3000

# API ключ (на проде — GitHub Actions secret)
API_KEY=

# Секрет для подписи JWT (обязательно на проде)
JWT_SECRET=

# Опционально: создать/обновить admin при старте API
ADMIN_EMAIL=
ADMIN_PASSWORD=
