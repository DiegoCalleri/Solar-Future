# MongoDB (локальный запуск: 127.0.0.1; в Docker значение задаётся в docker-compose)
MONGODB_URI=mongodb://127.0.0.1:27017/solar

# Порт API (опционально)
PORT=4000

# Разрешённые origins для CORS (через запятую, без пробелов или с пробелами — обрежутся)
CORS_ORIGINS=https://test.ru,http://127.0.0.1:3000

# API ключ (на проде задаётся из GitHub Actions secrets)
API_KEY=
